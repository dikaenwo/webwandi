        <!-- ═══════════════════════════════════════════════ -->
        <!-- RELASI / EDGES                                 -->
        <!-- ═══════════════════════════════════════════════ -->

        <!-- categories (1) → menus (N) : ONE-TO-MANY [FK CONSTRAINT] -->
        <!-- source=menus.category_id, target=categories.id -->
        <!-- startArrow=many side (menus), endArrow=one side (categories) -->
