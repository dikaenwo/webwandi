        <mxCell id="m6" value="Klik 'Tandai Siap'&#xa;PUT: status=ready" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="376" width="160" height="50" as="geometry" /></mxCell>
        <mxCell id="m7" value="Status Order&#xa;→ ready ✅" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=15;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1040" y="376" width="150" height="50" as="geometry" /></mxCell>

