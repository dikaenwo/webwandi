               Tidak → Logout → Selesai
             ====================================================== -->
        <mxCell id="p1" value="Buka Menu&#xa;'Laporan'" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=15;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="716" width="140" height="50" as="geometry" /></mxCell>
        <mxCell id="p2" value="Pilih Rentang Waktu&#xa;(Hari / Minggu / Bulan / Custom)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=15;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="180" y="716" width="210" height="50" as="geometry" /></mxCell>
        <mxCell id="p3" value="Load Data Analitik&#xa;GET /kasir/api/analytics/data" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y="716" width="200" height="50" as="geometry" /></mxCell>
